# Biến môi trường cho service. Copy thành .env và sửa.
# Nạp:  set -a; . deploy/.env; set +a   (hoặc khai Environment= trong systemd)

HOST=0.0.0.0
PORT=8080

# Số Chrome chạy song song. 1 là an toàn cho 4GB RAM. >=8GB mới nên tăng.
WORKERS=1

# Giới hạn & thời gian
MAX_QUEUE=300
JOB_TIMEOUT=240
MAX_TRIES=2
RETRY_DELAY=3

# Cache link đích (giây). 21600 = 6 giờ.
CACHE_TTL=21600
CACHE_ENABLED=1

# Bảo vệ API: để trống = công khai. Đặt chuỗi bí mật + gửi header X-API-Key.
API_KEY=

# Chrome: 1 = chạy --headless=new (server không Xvfb), 0 = có display ảo.
L4M_HEADLESS=0

# Bỏ proxy env khi khởi động (bắt buộc với link4m — đi thẳng mới qua Cloudflare).
CLEAR_PROXY=1
