# Discord Bot Configuration Example
# Đổi tên file này thành .env hoặc cấu hình trên Environment Variables của Host (Render/Railway/Heroku/VPS)

DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=1182983270556774420
MAX_CONCURRENT=2

# Đường dẫn python trên host (tùy chọn, mặc định tự tìm python3 hoặc python)
# PYTHON_PATH=/usr/bin/python3

# Khóa API solver tùy chọn — để trống thì solver tương ứng tự tắt
# OCILAR_API_KEY=
# PASSX_KEY=

# Interpreter thay thế cho runner trafficvn (tùy chọn)
# PYTHON_311=/usr/bin/python3.11
