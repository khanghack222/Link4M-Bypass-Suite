# ==============================================================================
# Link4M & Discord Bot Configuration
# ==============================================================================
# Đổi tên file này thành .env và điền các khóa cần thiết.

# ------------------------------------------------------------------------------
# 1. Discord Bot Configuration
# ------------------------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=1182983270556774420
# MAX_CONCURRENT=1 khuyến nghị trên máy 3.7GB RAM để tránh chạy 2 Chrome đồng thời
MAX_CONCURRENT=1

# ------------------------------------------------------------------------------
# 2. Native Rust Engine (l4m-engine) Integration
# ------------------------------------------------------------------------------
# URL của Rust CDP Engine daemon (mặc định chạy cổng 8080 nội bộ)
L4M_ENGINE_URL=http://127.0.0.1:8080

# Khóa bảo vệ API của Engine (tùy chọn — để trống nếu chỉ chạy local 127.0.0.1)
L4M_API_KEY=

# Số lần tự động thử lại khi gặp audio challenge block hoặc IP rate limit (1-5)
L4M_JOB_RETRIES=3

# ------------------------------------------------------------------------------
# 3. Low-RAM Linux Optimization (3.7 GB RAM Host Tuning)
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8080

# Số worker Chrome đồng thời (1 worker an toàn tuyệt đối cho VPS 3.7GB)
WORKERS=1

# 0 = Lazy start Chrome khi có job (tiết kiệm ~400MB RAM khi idle)
# 1 = Giữ sẵn 1 Chrome chạy ngầm để giảm latency
L4M_PREWARM=0

# Chế độ Chrome: 1 = Headless mới, 0 = Headful (cần DISPLAY hoặc xvfb-run)
L4M_HEADLESS=1

# Đường dẫn Chrome trên Linux (tự tìm nếu để trống)
CHROME_BIN=/usr/bin/google-chrome

# Mô hình Whisper offline cho giải mã âm thanh reCAPTCHA v2
WHISPER_MODEL=engine-rs/models/ggml-tiny.en.bin

# ------------------------------------------------------------------------------
# 4. Proxy Pool & Rotation
# ------------------------------------------------------------------------------
# Danh sách proxy dự phòng (HTTP / SOCKS5). Tự reload khi file thay đổi.
PROXY_FILE=proxies.txt

# 1 = Tự động xoay proxy exit sau mỗi lượt bypass hoàn tất
PROXY_ROTATE=1

# 1 = Bật Cloudflare WARP spoofing (giả lập warp=off để vượt qua bộ lọc anti-proxy)
L4M_SPOOF_WARP=1

# Thời gian làm mát (giây) khi proxy bị Link4M hoặc Google chặn (mặc định 300s)
PROXY_COOLDOWN=300

# ------------------------------------------------------------------------------
# 5. Legacy Python Core Fallback (Chỉ dùng khi Rust daemon không khả dụng)
# ------------------------------------------------------------------------------
# PYTHON_PATH=/usr/bin/python3
# OCILAR_API_KEY=
# PASSX_KEY=
