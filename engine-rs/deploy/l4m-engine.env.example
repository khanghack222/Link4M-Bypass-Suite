# /etc/l4m-engine.env — sample for deploy/l4m-engine.service

HOST=127.0.0.1
PORT=8080
WORKERS=auto
MAX_QUEUE=100
MAX_BATCH=50

# Proxy pool (mỗi worker một exit). PROXY_ROTATE=1 đổi sau mỗi job;
# PROXY_ROTATE_AFTER tự đổi sau N lượt thành công khi pool có >1 proxy.
# PROXY_LIST=user:pass@1.2.3.4:8000,5.6.7.8:3128
PROXY_FILE=data/proxies.txt
PROXY_ROTATE=0
PROXY_ROTATE_AFTER=4
# Giây một exit lỗi bị loại khỏi vòng xoay (mặc định 300).
PROXY_COOLDOWN=300
JOB_TIMEOUT=480

# Cache
CACHE_ENABLED=true
CACHE_TTL=21600
CACHE_FILE=data/native_cache.json

# Queue + board survive restart (atomic JSON snapshots).
QUEUE_FILE=data/queue.json
LINKS_FILE=data/links.json
QUEUE_RESUME=1
# 0 = job đang chạy lúc crash bị đánh failed thay vì chạy lại.
QUEUE_RESUME_RUNNING=1

# Sponsor-code cache: proven codes only, reused per campaign id.
L4M_CODE_TTL=900
L4M_CODE_FILE=data/codes.json
L4M_CAMPAIGN_CACHE=data/campaigns.json

# Chrome. Must stay headful; xvfb-run supplies DISPLAY.
L4M_HEADLESS=0
CHROME_BIN=/opt/google/chrome/chrome
CHROME_PROFILE=data/profile-main

# OCR sidecar for instruction images (rapidocr in a venv).
# Nếu sidecar chết/thiếu, engine thử tesseract trong PATH (L4M_TESSERACT).
L4M_PYTHON=/opt/l4m-engine/.venv/bin/python
L4M_OCR=/opt/l4m-engine/tools/ocr.py
# L4M_TESSERACT=tesseract

# whisper.cpp
WHISPER_MODEL=models/ggml-tiny.en.bin
ASR_THREADS=2

RUST_LOG=engine=info,l4m_engine=info

# API_KEY=change-me
