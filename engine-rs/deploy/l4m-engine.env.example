# /etc/l4m-engine.env — sample for deploy/l4m-engine.service

HOST=127.0.0.1
PORT=8080
WORKERS=auto
MAX_QUEUE=100
MAX_BATCH=50

# Proxy pool (mỗi worker một exit). PROXY_ROTATE=1 đổi sau mỗi job;
# PROXY_ROTATE_AFTER tự đổi sau N lượt thành công khi pool có >1 proxy.
# HTTP và SOCKS5 đều được; PROXY_FILE tự reload khi mtime/size đổi.
# PROXY_LIST=user:pass@1.2.3.4:8000,5.6.7.8:3128
# PROXY_LIST=socks5://user:pass@1.2.3.4:1080
PROXY_FILE=data/proxies.txt
PROXY_ROTATE=0
PROXY_ROTATE_AFTER=4
# Giây một exit lỗi bị loại khỏi vòng xoay (mặc định 300).
PROXY_COOLDOWN=300
JOB_TIMEOUT=480

# Cache
CACHE_ENABLED=true
CACHE_TTL=21600
CACHE_FILE=data/native_cache.json

# Queue + board survive restart (atomic JSON snapshots).
QUEUE_FILE=data/queue.json
LINKS_FILE=data/links.json
QUEUE_RESUME=1
# 0 = job đang chạy lúc crash bị đánh failed thay vì chạy lại.
QUEUE_RESUME_RUNNING=1

# Sponsor-code cache: proven codes only, reused per campaign id.
L4M_CODE_TTL=900
L4M_CODE_FILE=data/codes.json
L4M_CAMPAIGN_CACHE=data/campaigns.json

# Chrome. Must stay headful; xvfb-run supplies DISPLAY.
L4M_HEADLESS=0
CHROME_BIN=/opt/google/chrome/chrome
CHROME_PROFILE=data/profile-main

# OCR sidecar for instruction images (rapidocr in a venv).
# Nếu sidecar chết/thiếu, engine thử tesseract trong PATH (L4M_TESSERACT).
L4M_PYTHON=/opt/l4m-engine/.venv/bin/python
L4M_OCR=/opt/l4m-engine/tools/ocr.py
# L4M_TESSERACT=tesseract
# OCR remote (multipart) ưu tiên hơn sidecar; cache bền theo campaign+hash ảnh.
# OCR_URL=http://127.0.0.1:9003/ocr
# OCR_TIMEOUT=30
# OCR_LANGUAGE=vi+en
# L4M_OCR_CACHE=data/ocr-cache.json
# Sidecar RapidOCR thường trú: nạp model một lần cho cả phiên (tốn ~145 MB).
# L4M_OCR_SERVE=1
# OCR_SERVE_TIMEOUT=90

# Worker giữ sẵn một Chrome boot khi idle (0 = tắt, tiết kiệm RAM).
L4M_PREWARM=1

# whisper.cpp local (mặc định). Bỏ qua toàn bộ khi đặt ASR_URL.
WHISPER_MODEL=models/ggml-tiny.en.bin
ASR_THREADS=2
# ASR remote: whisper.cpp server hoặc endpoint OpenAI-compatible.
# Bare host tự thêm /inference; path cụ thể giữ nguyên.
# ASR_URL=http://127.0.0.1:8081/inference
# ASR_LANGUAGE=en
# ASR_TIMEOUT=90

# Solver reCAPTCHA v2 ngoài (tùy chọn). Token được tiêm vào page hiện tại,
# nên session Link4M vẫn là của engine. Rỗng = tắt, dùng audio trong page.
# RC_SOLVER_CMD=/opt/l4m-engine/.venv/bin/python /opt/recaptcha-vm/solve_service.py
# RC_SOLVER_SUBCOMMAND=solve
# RC_SOLVER_SITEKEY=6LcQsTQgAAAAADNQ_pCfukfvS0i9lk4oJTVSs5bZ
# RC_SOLVER_MODEL=tiny.en
# RC_SOLVER_ROUNDS=4
# RC_SOLVER_TIMEOUT=180

RUST_LOG=engine=info,l4m_engine=info

# API_KEY=change-me
