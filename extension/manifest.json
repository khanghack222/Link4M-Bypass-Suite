{
  "manifest_version": 3,
  "name": "Link4M Auto Bypass Suite - ProMax",
  "version": "2.1.0",
  "description": "Tự động vượt link rút gọn Link4M & Nhiệm vụ Nhà tài trợ (What-on/Gtraffic/Layma). Hỗ trợ giải Captcha thủ công tự động tiếp tục.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.link4m.net/*",
    "*://*.link4m.co/*",
    "*://*.link4m.app/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.link4m.net/*",
        "*://*.link4m.co/*",
        "*://*.link4m.app/*"
      ],
      "js": [
        "domain_solver.js",
        "ui_hud.js",
        "content_link4m.js"
      ],
      "css": [
        "ui_hud.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.link4m.net/*",
        "*://*.link4m.co/*",
        "*://*.link4m.app/*",
        "*://*.google.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "sponsor_patch.js",
        "content_sponsor.js"
      ],
      "css": [
        "sponsor_hud.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Link4M Auto Bypass ProMax",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
