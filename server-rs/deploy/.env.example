# Copy sang .env rồi sửa. Mọi biến đều có default an toàn.

# ---- HTTP ----
HOST=0.0.0.0
PORT=8080
# Để trống = không cần auth. Đặt chuỗi dài nếu mở ra internet.
API_KEY=

# ---- Đường dẫn repo (binary tự dò nếu bỏ trống) ----
# L4M_REPO=/app
PYTHON=/usr/bin/python3

# ---- Engine ----
# cdp   : Chrome CDP sẵn có (đã kiểm chứng với link4m thật)
# legacy: Playwright tự mở browser
L4M_ENGINE=cdp
L4M_HEADLESS=1

# ---- Hàng đợi ----
WORKERS=1
MAX_QUEUE=300
JOB_TIMEOUT=480
MAX_TRIES=2
RETRY_DELAY=3

# ---- Cache ----
CACHE_ENABLED=true
CACHE_TTL=21600
# CACHE_FILE=/app/data/rust_cache.json

# ---- Log ----
RUST_LOG=bypass_server=info,tower_http=info
